<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Grocery.App.ViewModels"
             x:Class="Grocery.App.Views.NewProductView"
             Title="Nieuw Product">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Entry Placeholder="Naam" Text="{Binding Name}" />
            <Entry Placeholder="Voorraad" Keyboard="Numeric" Text="{Binding Stock}" />
            <DatePicker Date="{Binding ShelfLife, Mode=TwoWay}" />
            <Entry Placeholder="Prijs (€)" Keyboard="Numeric" Text="{Binding Price}" />

            <Button Text="Opslaan"
                    Command="{Binding AddProductCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>